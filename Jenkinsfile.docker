pipeline {
    agent any
    options { disableConcurrentBuilds() }
    parameters {
        string(name: 'GHCR_OWNER', defaultValue: '', description: 'Your GitHub username or organization, lowercase')
    }
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('Build and push Docker image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'ghcr-login', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        if ($env:GHCR_OWNER -cnotmatch '^[a-z0-9][a-z0-9-]*$') { throw 'Enter a lowercase GHCR_OWNER.' }
                        function Invoke-Docker {
                            & docker @args
                            if ($LASTEXITCODE -ne 0) { throw "Docker command failed: $($args[0])" }
                        }
                        $image = "ghcr.io/$env:GHCR_OWNER/pep-website"
                        $env:DOCKER_CONFIG = Join-Path $env:WORKSPACE '.docker-ci'
                        try {
                            $engine = & docker info --format '{{.OSType}}'
                            if ($LASTEXITCODE -ne 0 -or $engine -ne 'linux') { throw 'Jenkins needs access to Docker running Linux containers.' }
                            $env:GHCR_TOKEN | & docker login ghcr.io --username $env:GHCR_USER --password-stdin
                            if ($LASTEXITCODE -ne 0) { throw 'GHCR login failed.' }
                            Invoke-Docker build -f Dockerfile -t "${image}:$env:BUILD_NUMBER" -t "${image}:latest" .
                            Invoke-Docker push "${image}:$env:BUILD_NUMBER"
                            Invoke-Docker push "${image}:latest"
                            Write-Host "Published ${image}:$env:BUILD_NUMBER and ${image}:latest"
                        } finally {
                            if (Test-Path -LiteralPath $env:DOCKER_CONFIG) { Remove-Item -LiteralPath $env:DOCKER_CONFIG -Recurse -Force }
                        }
                    '''
                }
            }
        }
    }
}
